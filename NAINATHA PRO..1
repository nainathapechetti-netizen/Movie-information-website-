<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vespera: Zero Horizon — Movie Info</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-primary: #07090f;
      --bg-elevated: #0e1320;
      --surface: rgba(20, 27, 45, 0.72);
      --surface-hover: rgba(30, 40, 66, 0.88);
      --border: rgba(255, 255, 255, 0.09);
      --text-primary: #f5f7fb;
      --text-secondary: #9aa5be;
      --text-muted: #68738d;
      --accent: #f59e0b;
      --accent-soft: rgba(245, 158, 11, 0.14);
      --accent-glow: rgba(245, 158, 11, 0.35);
      --cyan: #38bdf8;
      --radius-lg: 20px;
      --radius-md: 14px;
      --radius-sm: 8px;
      --transition: 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img {
      display: block;
      max-width: 100%;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
      color: inherit;
    }

    button:focus-visible, a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Top Nav */
    .topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 40;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: rgba(7, 9, 15, 0.65);
      border-bottom: 1px solid var(--border);
    }

    .topbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-weight: 800;
      letter-spacing: 0.12em;
      font-size: 0.95rem;
      text-transform: uppercase;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .brand-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .nav-links a {
      text-decoration: none;
      color: inherit;
      transition: color var(--transition);
    }

    .nav-links a:hover {
      color: var(--text-primary);
    }

    /* Hero Section */
    .hero {
      position: relative;
      min-height: 86vh;
      display: flex;
      align-items: flex-end;
      padding: 6.5rem 1.5rem 3.5rem;
      overflow: hidden;
    }

    .hero-backdrop {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: blur(2px) brightness(0.42) saturate(1.15);
      transform: scale(1.04);
      z-index: 0;
    }

    .hero-scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(7, 9, 15, 0.94) 0%, rgba(7, 9, 15, 0.72) 55%, rgba(7, 9, 15, 0.35) 100%),
        linear-gradient(180deg, rgba(7, 9, 15, 0.3) 0%, rgba(7, 9, 15, 0.85) 82%, var(--bg-primary) 100%);
      z-index: 1;
    }

    .container {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 270px 1fr;
      gap: 2.5rem;
      align-items: end;
    }

    .poster-card {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75);
      aspect-ratio: 2 / 3;
      background: var(--bg-elevated);
    }

    .poster-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

